{
"compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
},
"include": ["src/**/*.ts", "pruebas/**/*.ts"],
"exclude": ["dist", "node_modules"]
}
